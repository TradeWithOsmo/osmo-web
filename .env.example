# Privy Configuration
VITE_PRIVY_APP_ID=<your_privy_app_id>

# AI / Gemini
VITE_GEMINI_API_KEY=<your_gemini_api_key>
VITE_GEMINI_MODEL=gemini-1.5-flash

# Backend API URL
VITE_API_URL=http://localhost:8000

# Trading mode: onchain | simulation
# - onchain: requires session key + deployed contracts
# - simulation: uses backend ledger only (for UI testing)
VITE_TRADING_EXCHANGE=simulation

# Chain config
VITE_CHAIN_ID=84532
VITE_NETWORK_NAME=base_sepolia
VITE_BLOCK_EXPLORER_URL=https://sepolia.basescan.org
VITE_BASE_RPC_URL=<your_base_sepolia_rpc_url>

# WalletConnect / RainbowKit
VITE_WALLET_CONNECT_PROJECT_ID=<your_walletconnect_project_id>
VITE_RAINBOWKIT_WALLETCONNECT_PROJECT_ID=<your_rainbowkit_wc_project_id>

# Contract Addresses — copy from osmo-contracts/.env after deployment
VITE_CONTRACT_TRADING_VAULT=
VITE_CONTRACT_ORDER_ROUTER=
VITE_CONTRACT_POSITION_MANAGER=
VITE_CONTRACT_SESSION_KEY_MANAGER=
VITE_CONTRACT_OSTIUM_ADAPTER=
VITE_CONTRACT_USDC=
VITE_CONTRACT_FAUCET=
VITE_CONTRACT_AI_VAULT=
VITE_CONTRACT_ARENA_CHOOSE_SIDE=
VITE_CONTRACT_ARENA_POINTS=
VITE_CONTRACT_REFERRAL_REGISTRY=
VITE_CONTRACT_FEE_MANAGER=
VITE_CONTRACT_SECURITY_MODULE=

# Arena end date (ISO format)
VITE_ARENA_END_ISO=2026-01-01T00:00:00Z

# Optional TradingView tuning (leave empty for defaults)
VITE_TV_COMMAND_POLL_MS=
VITE_TV_INITIAL_SYNC_MS=
VITE_TV_SET_RESOLUTION_TIMEOUT_MS=
